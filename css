+, display: none;       // Ẩn hoàn toàn phần tử và không chiếm không gian.
+, visibility: hidden; // Ẩn nội dung nhưng vẫn giữ chỗ trên layout.
+, opacity: 0;         // Làm phần tử trong suốt nhưng vẫn tương tác được và vẫn chiếm chỗ.
+, display: block;     // Biến phần tử thành dạng block (chiếm 100% chiều ngang, xuống dòng).
+, display: inline;    // Biến phần tử thành inline (không chỉnh width/height, đứng chung dòng).
+, display: inline-block; // cho phép phần tử đứng cùng hàng như inline nhưng vẫn chỉnh được width, height, margin, padding như block.
+, margin-block: 10px   // Tạo margin-top và margin-bottom = 10px
                           → Chỉ áp dụng cho các phần tử dạng block.

+, left: calc(100% - 10px); // left: calc(100% - 10px);
                               → Tính toán giá trị động:
                               left = 100% chiều rộng cha – 10px.

